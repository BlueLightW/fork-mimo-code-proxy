# Configurações existentes
MIMO_PROXY_TOKEN=your-secret-token
MIMO_SERVER_URL=http://127.0.0.1:5020
MIMO_PROXY_PORT=8787
MIMO_PROXY_MODE=raw

# ✅ NOVAS VARIÁVEIS PARA MÚLTIPLAS CONTAS
MIMO_MULTI_ACCOUNT=true          # Habilita múltiplas contas
MIMO_ACCOUNT_POOL_SIZE=5         # Tamanho do pool de contas ativas
MIMO_ACCOUNT_COOLDOWN_MS=60000   # Cooldown entre requisições (ms)
MIMO_MAX_CONCURRENCY=10           # Máximo de requisições simultâneas
MIMO_DB_PATH=./data/accounts.db   # Caminho do banco SQLite